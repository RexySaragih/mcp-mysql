# Variable NAMES for operators — placeholders only.
# Put REAL values in your agent mcp.json under mcpServers.mysql.mcp.env
# Do NOT create a project .env for runtime secrets.
# Prefer a MySQL user with SELECT-only privileges.

# Option A — URL
MYSQL_URL=mysql://readonly_user:your-password@127.0.0.1:3306/your_database

# Option B — discrete vars (used when MYSQL_URL is unset)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your_database

# Optional
MYSQL_SSL=false
MYSQL_QUERY_TIMEOUT_MS=30000
MYSQL_MAX_ROWS=100
