# Variable NAMES for operators — placeholders only.
# Put REAL values in your agent mcp.json under mcpServers.mysql.env
# Do NOT create a project .env for runtime secrets.
# Prefer a MySQL/MariaDB user with SELECT-only privileges.

# Option A — URL (database path becomes default schema)
MYSQL_URL=mysql://readonly_user:your-password@127.0.0.1:3306/your_database

# Option B — discrete vars (used when MYSQL_URL is unset; also override URL pieces)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=your_database

# Optional TLS
MYSQL_SSL=false
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_CERT=/path/to/client-cert.pem
# MYSQL_SSL_KEY=/path/to/client-key.pem
# MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Optional caps
MYSQL_QUERY_TIMEOUT_MS=30000
MYSQL_MAX_ROWS=100
