{
  "name": "@rexymayderio/mysql-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for MySQL schema inspection and SELECT queries",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mysql-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/test/**/*.test.js",
    "test:connections": "npm run build && node dist/scripts/test-connections.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "mysql",
    "database",
    "model-context-protocol"
  ],
  "author": "rexymayderio",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "mysql2": "3.23.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
